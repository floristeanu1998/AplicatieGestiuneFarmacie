<Window x:Class="FarmacieUI_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Farmacie - Detalii Medicament" Height="400" Width="450"
        Background="#ECF0F1">

    <Window.Resources>
        <Style x:Key="StilTitlu" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="StilValoare" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="8" Background="White" Padding="20">
            <StackPanel>

                <Label Content="Fișă Medicament" FontSize="24" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Label Content="ID și Denumire:" Style="{StaticResource StilTitlu}"/>
                <Label x:Name="lblDenumire" Content="-" Style="{StaticResource StilValoare}"/>

                <Label Content="Formă și Condiții de Păstrare:" Style="{StaticResource StilTitlu}"/>
                <Label x:Name="lblFormaConditii" Content="-" Style="{StaticResource StilValoare}"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Cantitate în stoc:" Style="{StaticResource StilTitlu}"/>
                        <Label x:Name="lblStoc" Content="-" Style="{StaticResource StilValoare}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Label Content="Preț (RON):" Style="{StaticResource StilTitlu}"/>
                        <Label x:Name="lblPret" Content="-" Style="{StaticResource StilValoare}" Foreground="#27AE60"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,15,0,15"/>

                <Label x:Name="lblStatus" Content="Status" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>