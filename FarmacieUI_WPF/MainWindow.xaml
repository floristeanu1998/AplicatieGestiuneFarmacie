<Window x:Class="FarmacieUI_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Farmacie - Adăugare Medicament" Height="500" Width="400"
        Background="#F4F6F6">

    <Grid Margin="20">
        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="8" Background="White" Padding="20">
            <StackPanel>
                <Label Content="Adaugă Medicament Nou" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Label Content="_Denumire (max 30 caractere):" Target="{Binding ElementName=txtDenumire}" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDenumire" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="tbErrDenumire" Foreground="Red" FontSize="11" Margin="0,2,0,10" Visibility="Collapsed"/>

                <Label Content="_Preț (RON):" Target="{Binding ElementName=txtPret}" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPret" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="tbErrPret" Foreground="Red" FontSize="11" Margin="0,2,0,10" Visibility="Collapsed"/>

                <Label Content="_Cantitate în stoc:" Target="{Binding ElementName=txtStoc}" FontWeight="Bold" Padding="0" Margin="0,0,0,5"/>
                <TextBox x:Name="txtStoc" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="tbErrStoc" Foreground="Red" FontSize="11" Margin="0,2,0,10" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Button x:Name="btnAdauga" Content="Adaugă" Width="100" Height="35" Margin="0,0,10,0" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="btnAdauga_Click"/>
                    <Button x:Name="btnReset" Content="Reset" Width="100" Height="35" Background="#95A5A6" Foreground="White" FontWeight="Bold" Click="btnReset_Click"/>
                </StackPanel>

                <Label x:Name="lblMesajStatus" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>