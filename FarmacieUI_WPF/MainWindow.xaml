<Window x:Class="NivelUIWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Farmacie - Lab 9" 
        MinWidth="900" MinHeight="650" Height="700" Width="1050"
        Background="#F4F6F6">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#34495E"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENIUL VERTICAL -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="10">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="FARMACIE" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button x:Name="btnMeniuAdauga" Content="➕ Adaugă Medicament" Height="40" Background="#34495E" Foreground="White" BorderThickness="0" Margin="0,0,0,10" Click="btnMeniuAdauga_Click"/>
                <Button x:Name="btnMeniuModifica" Content="✏️ Modifică Medicament" Height="40" Background="#34495E" Foreground="White" BorderThickness="0" Margin="0,0,0,10" Click="btnMeniuModifica_Click"/>
                <Button x:Name="btnMeniuCauta" Content="🔍 Caută Medicament" Height="40" Background="#34495E" Foreground="White" BorderThickness="0" Click="btnMeniuCauta_Click"/>
            </StackPanel>
        </Border>

        <!-- CONTINUTUL (Coloana 1) -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--  PANOU ADAUGARE  -->
            <StackPanel x:Name="panouAdaugare" Grid.Row="0" Visibility="Visible">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="Denumire:"/>
                        <TextBox x:Name="txtDenumire"/>

                        <Label Content="Preț (RON):" Margin="0,10,0,0"/>
                        <TextBox x:Name="txtPret"/>

                        <Label Content="Stoc:" Margin="0,10,0,0"/>
                        <TextBox x:Name="txtStoc"/>

                        <Label Content="Data Expirării:" Margin="0,10,0,0"/>
                        <DatePicker x:Name="dtpDataExpirare" Height="30" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <Label Content="Forma de prezentare:"/>
                        <WrapPanel Margin="0,5,0,10">
                            <RadioButton x:Name="rbComprimate" Content="Comprimate" GroupName="Forma" IsChecked="True" Margin="0,0,10,5"/>
                            <RadioButton x:Name="rbSirop" Content="Sirop" GroupName="Forma" Margin="0,0,10,5"/>
                            <RadioButton x:Name="rbUnguent" Content="Unguent" GroupName="Forma" Margin="0,0,10,5"/>
                            <RadioButton x:Name="rbSolutie" Content="Soluție Inj." GroupName="Forma" Margin="0,0,10,5"/>
                        </WrapPanel>

                        <Label Content="Condiții de păstrare:"/>
                        <Border BorderBrush="LightGray" BorderThickness="1" Padding="5">
                            <WrapPanel>
                                <CheckBox x:Name="chkTempCamerei" Content="Temp. camerei" Margin="5"/>
                                <CheckBox x:Name="chkRefrigerare" Content="Refrigerare" Margin="5"/>
                                <CheckBox x:Name="chkCongelare" Content="Congelare" Margin="5"/>
                                <CheckBox x:Name="chkLumina" Content="Ferit de lumină" Margin="5"/>
                                <CheckBox x:Name="chkUmiditate" Content="Ferit de umiditate" Margin="5"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <Label Content="Categorie (Selecție unică):"/>
                        <ListBox x:Name="lstCategorieAdaugare" Height="150" SelectionMode="Single" Background="#FDFDFD" BorderBrush="#CCCCCC" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="btnSalveaza" Content="Salvează Medicament" Width="180" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,20,0,0" HorizontalAlignment="Left" Click="btnSalveaza_Click"/>
            </StackPanel>

            <!--  PANOU NOU: MODIFICARE  -->
            <Border x:Name="panouModifica" Grid.Row="0" Visibility="Collapsed" Background="#FDFEFE" Padding="15" BorderBrush="#D5D8DC" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <Label Content="1. Selectează Medicamentul pe care vrei să-l modifici:"/>
                    <ComboBox x:Name="cmbMedicamenteModificare" Height="30" FontSize="14" DisplayMemberPath="AfisareComboBox" SelectionChanged="cmbMedicamenteModificare_SelectionChanged" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="Noua Denumire:"/>
                            <TextBox x:Name="txtModificaDenumire"/>

                            <Label Content="Noul Preț (RON):" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtModificaPret"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Label Content="Noul Stoc:"/>
                            <TextBox x:Name="txtModificaStoc"/>

                            <Label Content="Noua Dată a Expirării:" Margin="0,10,0,0"/>
                            <DatePicker x:Name="dtpModificaDataExpirare" Height="30" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="btnActualizeaza" Content="Actualizează Datele" Width="180" Height="35" Background="#E67E22" Foreground="White" FontWeight="Bold" Margin="0,20,0,0" HorizontalAlignment="Left" Click="btnActualizeaza_Click"/>
                </StackPanel>
            </Border>

            <!--  PANOU CAUTARE-->
            <Border x:Name="panouCautare" Grid.Row="0" Visibility="Collapsed" Background="#E8ECEF" Padding="15" CornerRadius="5">
                <StackPanel>
                    <Label Content="Caută după denumire:"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtCautare" Width="250" Margin="0,0,10,0"/>
                        <Button x:Name="btnExecutaCautare" Content="Caută" Width="100" Background="#2980B9" Foreground="White" Click="btnExecutaCautare_Click"/>
                        <Button x:Name="btnAfiseazaToti" Content="Arată Toți" Width="100" Margin="10,0,0,0" Background="#95A5A6" Foreground="White" Click="btnAfiseazaToti_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Mesaj Status -->
            <Label x:Name="lblStatus" Grid.Row="1" Margin="0,10,0,10" Foreground="Green" HorizontalAlignment="Center"/>

            <!--  DATAGRID (Tabelul) -->
            <DataGrid x:Name="dgMedicamente" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AlternatingRowBackground="#F9F9F9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdMedicament}" Width="40"/>
                    <DataGridTextColumn Header="Denumire" Binding="{Binding Denumire}" Width="120"/>
                    <DataGridTextColumn Header="Categorie" Binding="{Binding Categorie}" Width="100"/>
                    <DataGridTextColumn Header="Preț" Binding="{Binding Pret}" Width="60"/>
                    <DataGridTextColumn Header="Stoc" Binding="{Binding CantitateStoc}" Width="50"/>
                    <DataGridTextColumn Header="Formă" Binding="{Binding Forma}" Width="90"/>
                    <DataGridTextColumn Header="Expiră la" Binding="{Binding DataExpirare, StringFormat=dd.MM.yyyy}" Width="80"/>
                    <DataGridTextColumn Header="Actualizat" Binding="{Binding DataActualizare, StringFormat=HH:mm (dd.MM)}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</Window>